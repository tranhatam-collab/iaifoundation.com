{
  "name": "intent-os",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "wrangler -c apps/api/wrangler.toml dev",
    "deploy": "wrangler -c apps/api/wrangler.toml deploy",
    "db:migrate": "wrangler -c apps/api/wrangler.toml d1 migrations apply intent-os-db",
    "db:migrate:local": "wrangler -c apps/api/wrangler.toml d1 migrations apply intent-os-db --local",
    "db:seed": "wrangler -c apps/api/wrangler.toml d1 execute intent-os-db --file=packages/db/seeds/mvp-dev-seed.sql",
    "site:build": "node scripts/build-pages-static.mjs",
    "site:preview": "python3 -m http.server 4173 --directory .wrangler/pages-build",
    "site:qa:menu": "node scripts/run-menu-browser-qa.mjs",
    "site:deploy": "npm run site:build && node scripts/site-deploy.mjs",
    "deps:clean": "rm -rf node_modules package-lock.json && npm install",
    "lint": "eslint . --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260101.0",
    "@types/node": "^24.3.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.0.0"
  }
}
